<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RadioGroup
        android:id="@+id/rg_avm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="61dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_playback"
            android:layout_width="173dp"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="@string/str_video_playback"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <RadioButton
            android:id="@+id/rb_format"
            android:layout_width="173dp"
            android:layout_height="50dp"
            android:layout_marginLeft="49dp"
            android:background="#111827"
            android:button="@null"
            android:gravity="center"
            android:text="@string/str_format"
            android:textColor="#CBD5E1"
            android:textSize="40sp" />

        <RadioButton
            android:id="@+id/rb_switch"
            android:layout_width="173dp"
            android:layout_height="50dp"
            android:layout_marginLeft="49dp"
            android:background="#111827"
            android:button="@null"
            android:gravity="center"
            android:text="@string/str_switch_setting"
            android:textColor="#CBD5E1"
            android:textSize="40sp" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
